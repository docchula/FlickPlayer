{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flickplayer",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./www/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/__/auth/*", "/__/firebase/init.json"]
  },
  // Required by `wrangler preview` (used by Cloudflare for PR preview builds).
  // Top-level settings (assets, compatibility, etc.) are inherited.
  "previews": {}
}
